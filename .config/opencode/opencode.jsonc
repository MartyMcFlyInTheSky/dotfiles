{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "exa"
  },
  "compaction": {
    "auto": true
  },
  "plugins": [
    {
      "package": "./plugin/session-identity",
      "options": {
        "prompt": true
      }
    },
    "opencode-claude-subscription"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ],
        "disabled": false
      },
      "atlassian-rovo": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": false
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.config/nvim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.local/share/nvim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.config/vim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.cargo/registry/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/dev2/neovim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.config/opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/usr/local/share/nvim/runtime/doc/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.opensrc/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/sbeer/.config/i3/*",
      "effect": "allow"
    }
  ],
  "agents": {
    "review": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git fetch *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "glab *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uv *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        }
      ]
    },
    "vcs-remote": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "glab *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git fetch *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git merge-base *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git ls-remote *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git ls-files *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git remote -v *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rm *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "echo *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "mktemp *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "printf *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "whoami *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cut *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "true *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh pr checks *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "break *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sleep *",
          "effect": "allow"
        }
      ]
    }
  },
  "providers": {
    "inhouse": {
      "name": "In-house vLLM",
      "models": {
        "Qwen/Qwen3-30B-A3B-GPTQ-Int4": {
          "name": "Qwen3 30B A3B GPTQ Int4"
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:8000/v1",
        "apiKey": "local"
      }
    },
    "inhouse-ollama": {
      "name": "In-house Ollama Muse Glimmer",
      "models": {
        "muse-glimmer": {
          "name": "Muse Glimmer 30B Q4_K_M",
          "family": "muse-glimmer",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "compatibility": {
            "reasoningField": "reasoning"
          }
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:11434/v1",
        "apiKey": "ollama",
        "timeout": false
      }
    },
    "inhouse-smoke": {
      "name": "In-house vLLM smoke",
      "models": {
        "Qwen/Qwen3-0.6B": {
          "name": "Qwen3 0.6B smoke",
          "limit": {
            "context": 40960,
            "output": 4096
          }
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:18000/v1",
        "apiKey": "local"
      }
    },
    "openai": {
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.2-codex": {
