{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/sbeer/.agents/skills/caveman/SKILL.md"],
  "permission": {
    "external_directory": {
      "/home/sbeer/.config/nvim/*": "allow",
      "/home/sbeer/.local/share/nvim/*": "allow",
      "/home/sbeer/.config/vim/*": "allow",
      "/home/sbeer/.cargo/registry/*": "allow",
      "/home/sbeer/dev2/neovim/*": "allow",
      "/home/sbeer/.config/opencode/*": "allow",
      "/usr/local/share/nvim/runtime/doc/*": "allow",
      "/home/sbeer/.opensrc/*": "allow",
      "/home/sbeer/.config/i3/*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "plugin": [
    "opencode-openai-codex-auth",
    "opencode-gemini-auth@latest",
    "opencode-claude-auth@latest",
    ["opencode-session-identity", {
      "shell": true,
      "prompt": true
    }]
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "atlassian-rovo": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    }
  },
  // Keep GitLab MCP registered globally, but disabled for all agents by default.
  "tools": {
    "gitlab*": false
  },
  "provider": {
    "inhouse": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "In-house vLLM",
      "options": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "Qwen/Qwen3-30B-A3B-GPTQ-Int4": {
          "name": "Qwen3 30B A3B GPTQ Int4"
        }
      }
    },
    "inhouse-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "In-house Ollama Muse Glimmer",
      "options": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:11434/v1",
        "apiKey": "ollama",
        "timeout": false
      },
      "models": {
        "muse-glimmer": {
          "name": "Muse Glimmer 30B Q4_K_M",
          "family": "muse-glimmer",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": "reasoning",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "status": "active"
        }
      }
    },
    "inhouse-smoke": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "In-house vLLM smoke",
      "options": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:18000/v1",
        "apiKey": "local"
      },
      "models": {
        "Qwen/Qwen3-0.6B": {
          "name": "Qwen3 0.6B smoke",
          "limit": {
            "context": 40960,
            "output": 4096
          }
        }
      }
    },
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.2-codex": {
          "name": "GPT 5.2 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex-max": {
          "name": "GPT 5.1 Codex Max (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
