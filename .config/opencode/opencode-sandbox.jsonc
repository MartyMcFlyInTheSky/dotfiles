          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "capabilities": {
            "input": [
              "text",
