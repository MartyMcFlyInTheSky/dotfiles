{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "compaction": {
    "auto": true
  },
  "mcp": {},
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "opencode-openai-codex-auth",
    "opencode-gemini-auth@latest",
    "opencode-claude-auth@latest",
    {
      "package": "opencode-session-identity",
      "options": {
        "shell": true,
        "prompt": true
      }
    }
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "vcs-remote": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" }
      ]
    },
    "review": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "inhouse": {
      "name": "In-house vLLM",
      "models": {
        "Qwen/Qwen3-30B-A3B-GPTQ-Int4": {
          "name": "Qwen3 30B A3B GPTQ Int4"
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:8000/v1",
        "apiKey": "local"
      }
    },
    "inhouse-ollama": {
      "name": "In-house Ollama Muse Glimmer",
      "models": {
        "muse-glimmer": {
          "name": "Muse Glimmer 30B Q4_K_M",
          "family": "muse-glimmer",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "compatibility": {
            "reasoningField": "reasoning"
          }
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:11434/v1",
        "apiKey": "ollama",
        "timeout": false
      }
    },
    "inhouse-smoke": {
      "name": "In-house vLLM smoke",
      "models": {
        "Qwen/Qwen3-0.6B": {
          "name": "Qwen3 0.6B smoke",
          "limit": {
            "context": 40960,
            "output": 4096
          }
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://gpu-workstation01.sg.ch.t.meteomatics.com:18000/v1",
        "apiKey": "local"
      }
    },
    "openai": {
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.2-codex": {
          "name": "GPT 5.2 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "low",
