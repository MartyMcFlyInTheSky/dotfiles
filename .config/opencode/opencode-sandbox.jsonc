            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.1-codex-mini": {
          "name": "GPT 5.1 Codex Mini (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.1": {
          "name": "GPT 5.1 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "textVerbosity": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed",
                "textVerbosity": "high"
              }
            }
          ],
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "settings": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium"
      },
      "body": {
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    },
    "google": {
      "settings": {
        "projectId": "999087845388",
        "apiKey": "{env:GOOGLE_API_KEY}"
      }
    }
  }
}
